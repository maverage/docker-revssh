# syntax=docker/dockerfile:1.7
# docker-revssh: build context is this directory.

# HOST_KEY_MODE=embedded creates a PRIVATE server key as an image layer.
# NEVER push an embedded-mode image or its build cache to a registry.
FROM --platform=$BUILDPLATFORM alpine:3.24 AS hostkeybuild
ARG HOST_KEY_MODE=runtime
RUN apk add --no-cache openssh-keygen
RUN --mount=type=secret,id=revssh_hostkey,required=false \
    mkdir -p /hostdata && \
    case "$HOST_KEY_MODE" in \
      runtime) ;; \
      embedded) \
        if [ -s /run/secrets/revssh_hostkey ]; then \
          cp /run/secrets/revssh_hostkey /hostdata/ssh_host_ed25519_key; \
        else \
          ssh-keygen -q -t ed25519 -N '' -f /hostdata/ssh_host_ed25519_key; \
        fi; \
        chmod 600 /hostdata/ssh_host_ed25519_key; \
        ssh-keygen -y -f /hostdata/ssh_host_ed25519_key > /hostdata/ssh_host_ed25519_key.pub; \
        grep -q '^ssh-ed25519 ' /hostdata/ssh_host_ed25519_key.pub ;; \
      *) echo 'HOST_KEY_MODE must be runtime or embedded' >&2; exit 1 ;; \
    esac

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS initbuild
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY init.go .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /revssh-init init.go
COPY false.go .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/false false.go

FROM --platform=$BUILDPLATFORM golang:1.26 AS chiselbuild
RUN CGO_ENABLED=0 go install github.com/canonical/chisel/cmd/chisel@v1.5.1

FROM --platform=$BUILDPLATFORM ubuntu:26.04 AS slicebuild
ARG TARGETARCH
# Chisel fetches release definitions from GitHub over HTTPS.
# The minimal Ubuntu builder needs an explicit CA trust bundle.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=chiselbuild /go/bin/chisel /usr/local/bin/chisel
RUN mkdir -p /rootfs && chisel cut --release ubuntu-26.04 --arch "$TARGETARCH" --root /rootfs \
      openssh-server_bins openssh-server_config \
    && mkdir -p /rootfs/var/empty /rootfs/run/sshd /rootfs/data

FROM scratch
COPY --from=slicebuild /rootfs/ /
COPY --from=initbuild /revssh-init /revssh-init
COPY --from=initbuild /out/false /bin/false
COPY sshd_config /etc/ssh/sshd_config
COPY passwd /etc/passwd
COPY group /etc/group
COPY --chmod=0600 shadow /etc/shadow
COPY --from=hostkeybuild /hostdata/ /data/
ARG HOST_KEY_MODE=runtime
ENV REVSSH_HOST_KEY_MODE=${HOST_KEY_MODE} TUNNELS_FILE="" TUNNELS=""
EXPOSE 2222
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["/revssh-init", "healthcheck"]
ENTRYPOINT ["/revssh-init"]
